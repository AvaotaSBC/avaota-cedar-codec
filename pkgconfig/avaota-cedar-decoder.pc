prefix=/usr
libdir=${prefix}/lib/aarch64-linux-gnu/avaota-cedar
includedir=${prefix}/include/avaota-cedar

Name: avaota-cedar-decoder
Description: Private Allwinner Cedar decoder API for Avaota A1
Version: 0.3.0
Cflags: -I${includedir}
Libs: -L${libdir} -Wl,-rpath,${libdir} -lvdecoder -lMemAdapter -lcdc_base
