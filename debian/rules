#!/usr/bin/make -f

export DH_VERBOSE=0

%:
	dh $@

override_dh_auto_build:
	python3 scripts/build_ffmpeg.py

clean:
	rm -rf debian/.debhelper debian/tmp debian/avaota-cedar-runtime debian/avaota-cedar-encoder debian/avaota-cedar-decoder debian/avaota-cedar-common-dev debian/avaota-cedar-encoder-dev debian/avaota-cedar-decoder-dev debian/avaota-cedar-media debian/avaota-cedar-ffmpeg
	rm -f debian/debhelper-build-stamp debian/files debian/*.substvars debian/*.debhelper.log
	dh_clean

override_dh_auto_install:
	test -f vendor/arm64/libvencoder.so.blob
	test -f vendor/arm64/libvdecoder.so.blob
	install -d debian/tmp/usr/lib/aarch64-linux-gnu/avaota-cedar
	set -e; for blob in vendor/arm64/*.so*.blob; do name=$$(basename "$$blob" .blob); install -m 0644 "$$blob" "debian/tmp/usr/lib/aarch64-linux-gnu/avaota-cedar/$$name"; done
	aarch64-linux-gnu-gcc -std=c11 -O2 -fPIC -shared -Ivendor/include bridge/avaota_cedar_bridge.c -Ldebian/tmp/usr/lib/aarch64-linux-gnu/avaota-cedar -lvencoder -lMemAdapter -lcdc_base -Wl,-rpath,'$$ORIGIN' -o debian/tmp/usr/lib/aarch64-linux-gnu/avaota-cedar/libavaota-cedar-bridge.so
	set -e; for so in debian/tmp/usr/lib/aarch64-linux-gnu/avaota-cedar/*.so*; do patchelf --set-rpath '$$ORIGIN' "$$so"; done
	install -d debian/tmp/usr/include/avaota-cedar
	install -m 0644 vendor/include/*.h debian/tmp/usr/include/avaota-cedar/
	install -m 0644 bridge/avaota_cedar_bridge.h debian/tmp/usr/include/avaota-cedar/
	install -d debian/tmp/usr/lib/aarch64-linux-gnu/pkgconfig
	install -m 0644 pkgconfig/*.pc debian/tmp/usr/lib/aarch64-linux-gnu/pkgconfig/
	install -d debian/tmp/etc
	install -m 0644 vendor/cedarc.conf debian/tmp/etc/cedarc.conf
	python3 scripts/build_ffmpeg.py --install debian/tmp

# These are private vendor libraries; do not expose them as public shlibs.
override_dh_makeshlibs:

override_dh_dwz:

# Their ELF dependencies are checked by scripts/verify.py at import time.
override_dh_shlibdeps:
